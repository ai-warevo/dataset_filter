# --- GLOBAL FILTER SETTINGS ---
FILTER_MODE=strict
FILTER_THRESHOLD=0.65
FILTER_EXTENSIONS=.png,.jpg,.jpeg

# --- DETECTOR: MATCH (Identity) ---
DETECTOR_MATCH_TOLERANCE=0.55
DETECTOR_MATCH_WEIGHT=1.0
DEDUPLICATION_THRESHOLD=0.4

# --- DETECTOR: BLUR ---
DETECTOR_BLUR_THRESHOLD=120.0
DETECTOR_BLUR_WEIGHT=0.3

# --- DETECTOR: FACE COUNT ---
DETECTOR_FACE_COUNT_MAX=1
DETECTOR_FACE_COUNT_WEIGHT=1.0

# --- DETECTOR: SCALE ---
DETECTOR_SCALE_MIN=0.05
DETECTOR_SCALE_WEIGHT=0.5

# --- MICRO-ARTIFACT VALIDATION (Piercings) ---
MICRO_ARTIFACT_ENABLED=false
# Mode options: YOLO, HEURISTIC
MICRO_ARTIFACT_MODE=HEURISTIC
YOLO_MODEL_PATH=models/yolo_weights.pt

# --- CLI STRATEGY OVERRIDES ---
APP_DEFECT_MODE=purge
APP_MATCH_MODE=noop
